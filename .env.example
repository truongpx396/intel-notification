# intel-notification — service-mode environment.
# In library mode your host builds notify.Config itself; these are the container's inputs.
# See docs/configuration.md. Provider credentials are NOT here: they belong to the
# channel implementations your host constructs, which is why a shared deployment can
# hold per-tenant keys without the engine knowing any of them.

# --- required: no safe default exists for these -------------------------------
# The product identity. Two products sharing a deployment MUST NOT share a realm,
# or they share an idempotency key space and silently swallow each other's
# notifications as replays. Cannot be retrofitted cheaply.
NOTIFY_REALM=

NOTIFY_PG_DSN=postgres://postgres:postgres@localhost:5432/notify?sslmode=disable
NOTIFY_REDIS_URL=redis://localhost:6379/0

# --- delivery ------------------------------------------------------------------
NOTIFY_DELIVERY=outbox          # outbox (crash-safe, default) | direct (dev / in-app only)
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_BACKOFF_BASE=10s
NOTIFY_BACKOFF_CEILING=1h

# Fixed for the deployment's life. Changing it live re-maps in-flight rows to
# different drainers and DOUBLE-DELIVERS. Drain the outbox first -- see
# docs/operations.md#changing-the-shard-count.
NOTIFY_SHARDS=16

# --- lifecycle -----------------------------------------------------------------
NOTIFY_RETENTION_WINDOW=2160h       # 90d, read notifications
NOTIFY_DEAD_LETTER_RETENTION=720h   # 30d, independent of the inbox window
NOTIFY_DEFAULT_LOCALE=en
NOTIFY_DIGEST_MAX=100

# --- bus -----------------------------------------------------------------------
NOTIFY_SUBJECT_PREFIX=notify
NOTIFY_BUS=redis-streams        # redis-streams (default) | nats
# NOTIFY_NATS_URL=nats://localhost:4222
