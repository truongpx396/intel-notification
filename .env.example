# intel-notification — service-mode environment.
# In library mode your host builds notify.Config itself; these are the container's inputs.
# See docs/configuration.md. Provider credentials are NOT here: channel_providers rows
# reference them (env:NAME, file:/run/secrets/x, or a secret-manager URI), which is why
# a shared deployment can hold per-tenant keys without the engine storing any of them.

# --- required ------------------------------------------------------------------
NOTIFY_PG_DSN=postgres://postgres:postgres@localhost:5432/notify?sslmode=disable
NOTIFY_REDIS_URL=redis://localhost:6379/0

# --- identity (service mode) -------------------------------------------------------
# Which realm each producer principal may send as. A request never names its own
# realm; an unbound principal is rejected. Two products MUST NOT share a realm, or
# they share an idempotency key space and swallow each other's notifications.
NOTIFY_REALM_BINDINGS=local-producer=local
# Keys that verify each realm's recipient tokens (the inbox REST surface).
NOTIFY_RECIPIENT_JWKS=local=http://localhost:3000/.well-known/jwks.json
# Unsubscribe signing keys, kid=secret-ref; the first signs, all verify.
NOTIFY_UNSUBSCRIBE_KEYS=k1=env:NOTIFY_UNSUBSCRIBE_KEY_K1
NOTIFY_UNSUBSCRIBE_KEY_K1=change-me

# --- delivery ------------------------------------------------------------------
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_BACKOFF_BASE=10s
NOTIFY_BACKOFF_CEILING=1h
NOTIFY_CLAIM_LEASE=5m           # must exceed the slowest channel's send timeout
NOTIFY_POLL_INTERVAL=500ms

# A contention hint, changeable online. After LOWERING it, run
# run the rehome step in docs/operations.md#changing-the-shard-count.
NOTIFY_SHARDS=16

# --- lifecycle -----------------------------------------------------------------
NOTIFY_IDEMPOTENCY_WINDOW=168h      # 7d; minimum 24h
NOTIFY_RETENTION_WINDOW=2160h       # 90d, inbox partitions, read and unread
NOTIFY_DELIVERY_LOG_RETENTION=720h  # 30d
NOTIFY_DEAD_LETTER_RETENTION=720h   # 30d, independent of the inbox window
NOTIFY_DIGEST_MAX=100
NOTIFY_DEFAULT_LOCALE=en

# --- optional ingest bus ---------------------------------------------------------
# No broker is required. Set this only for producers that publish instead of calling;
# JetStream with replicated streams is the one supported ingest bus (see bus-subjects.md).
# NOTIFY_INGEST_NATS_URL=nats://localhost:4222
